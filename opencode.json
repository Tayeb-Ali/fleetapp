{
    "$schema": "https://opencode.ai/config.json",
    "instructions": ["AGENTS.md"],
    "skills": {
        "paths": [".agents/skills"]
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "enabled": true,
            "command": ["npx", "@playwright/mcp@latest"]
        },
        "vercel": {
            "type": "remote",
            "url": "https://mcp.vercel.com",
            "enabled": true
        }
    }
}
